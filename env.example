# Copy to .env:  cp env.example .env
# (Named env.example, not .env.example: the build environment does not allow writing dot-env files.)

# ── Database ─────────────────────────────────────────────────────────────
# Local docker compose db is published on 5433. Managed Postgres works too
# (the first migration runs CREATE EXTENSION IF NOT EXISTS vector).
DATABASE_URL=postgres://pulse:pulse@localhost:5433/pulse

# ── Web app ──────────────────────────────────────────────────────────────
# 32+ random chars. Generate: openssl rand -hex 32   (required in production)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public URL of the web app (used for links; https → Secure cookies)
APP_URL=http://localhost:3001

# ── LLM ──────────────────────────────────────────────────────────────────
# Provider chain: Cerebras (primary) → Google Gemini (fallback) → mock (last resort, offline).
# Failover on 429 / 5xx / timeouts / invalid output. Free tiers only: a shared rate limiter keeps
# every process inside their limits, and demo prompts are cached (repeat rehearsals cost nothing).
# Keys must be the real keys (a placeholder like "ключ-…" is detected and the provider disabled).
# Model variables accept a comma-separated failover list (tried in order inside one provider).
#
# Primary: Cerebras, OpenAI-compatible
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM_FAST_MODEL=llama3.1-8b
#
# Fallback: Google Gemini through its OpenAI-compatible endpoint (models chosen by `pnpm eval`)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash
#
# Optional: Anthropic joins the chain first when a key is set
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
#
# LLM_PROVIDER=mock forces the offline mock even with keys (the demo room also has a runtime switch)
LLM_PROVIDER=
# Debug: save every raw model output (text only) into this folder
LLM_RECORD_DIR=

# ── Telegram ─────────────────────────────────────────────────────────────
# From @BotFather. Disable group privacy (/setprivacy → Disable) so the bot sees all messages.
TELEGRAM_BOT_TOKEN=
# Company the bot belongs to (uuid). Empty = first company in the DB.
TELEGRAM_COMPANY_ID=
# Telegram Business connected-bot updates for 1:1 chats (true/false)
TELEGRAM_BUSINESS_ENABLED=false

# ── Behavior ─────────────────────────────────────────────────────────────
# copy = Approve copies text for the human to paste; bot = the bot posts it after Approve
SEND_MODE=copy
# Enables demo accounts, one-click login and the /demo control room
DEMO_MODE=true
# Single-service hosting: run the worker (queue, SLA, Telegram long poll) inside the web process,
# apply migrations on start and seed the demo into an empty database (with DEMO_MODE=true).
INLINE_WORKER=false
# Messages older than this many days are deleted by the retention job
DATA_RETENTION_DAYS=90

# ── Email (stretch, optional) ────────────────────────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
